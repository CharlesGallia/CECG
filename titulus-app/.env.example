# ─────────────────────────────────────────────────────────────────
# Variables d'environnement — Titulus Civilis
# À copier dans Vercel : Settings → Environment Variables
# (ne jamais commit ces valeurs dans le dépôt)
# ─────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────
# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=
# Clé publique anon (Settings → API → anon public — préfixe sb_publishable_)
VITE_SUPABASE_ANON_KEY=
# Clé service_role (Settings → API → service_role — TRÈS SENSIBLE, jamais exposée côté client)
SUPABASE_SERVICE_ROLE_KEY=

# ─── hCaptcha (https://dashboard.hcaptcha.com) ───────────────────
VITE_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# ─── Stripe (https://dashboard.stripe.com/apikeys) ────────────────
# IMPORTANT : commencez avec les clés TEST (pk_test_, sk_test_).
# Bascule en LIVE seulement après recette complète.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# À renseigner après création du webhook (Stripe → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=

# ─── Resend (https://resend.com/api-keys) ─────────────────────────
RESEND_API_KEY=
# Adresse expéditrice (le domaine doit être vérifié dans Resend)
RESEND_FROM_EMAIL=Imperio Gallorum Sociatis <noreply@gallia.space>

# ─── URL publique (utilisée par Stripe success_url + e-mails) ────
VITE_PUBLIC_BASE_URL=https://adherer.gallia.space
